# Response headers for Cloudflare (Pages or Workers static assets) and Netlify.
# GitHub Pages ignores this file.

# content-hashed by the build: safe to keep forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# the service worker and the page shells must always be checked for a new version
/sw.js
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://upload.wikimedia.org https://lh3.googleusercontent.com; connect-src 'self' https://upload.wikimedia.org https://accounts.google.com/gsi/ https://api.open-meteo.com https://geocoding-api.open-meteo.com https://en.wikipedia.org; frame-src https://accounts.google.com/gsi/; font-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'; upgrade-insecure-requests
