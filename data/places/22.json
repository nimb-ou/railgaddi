a.","ll":[23.4213,88.5097]},{"n":"Krishnanagar Roman Catholic Church","k":"see","d":"It stands out for its distinctive architecture. There are 27 oil paintings describing the life of Jesus Christ. There also is a Protestant church in the same compound.","ll":[23.4052,88.4861]}],"c":[10,25,9,14,30,16,19,36,30,24,39,66,26,37,162,26,34,232,26,31,314,26,31,260,25,31,217,22,30,135,16,27,17,11,24,11],"cs":"est"},"Mahabubnagar":{"x":"Mahabubnagar is a town southwest of Hyderabad, in West Telangana.","sights":[{"n":"Koil Sagar","k":"see","d":"One of the famous tourist attractions of West Telangana with a Veerabadhra temple called Koil Konda.","img":"Koilsagar.jpg","ll":[16.70778,77.77639]},{"n":"Manyamkonda","k":"see","d":"A hilltop shrine of Lord Venkateshwara. There is also a temple of Lord Shiva.","ll":[16.6558,77.88437]}],"c":[15,30,6,17,34,3,21,37,17,24,39,24,26,39,44,23,33,99,22,31,137,21,30,146,21,29,154,20,29,91,17,29,16,14,29,2],"cs":"est"},"Nagapattinam":{"x":"Nagapattinam is a port town in Tamil Nadu.","sights":[{"n":"Kayarohanaswami Temple","k":"see","img":"Nagai Karonam1.JPG","ll":[10.76636,79.84259]},{"n":"Nagore Dargah Shariff","k":"see","img":"Nagore Dargah minaret.jpg","ll":[10.81825,79.84184]},{"n":"Soundararajaperumal Temple","k":"see","img":"Thirunagai13.JPG","ll":[10.76056,79.84]},{"n":"Basilica of Our Lady of Good Health","k":"see","d":"Church in Tamil Nadu, India","img":"Vailankanni Basilica1.jpg","ll":[10.68031,79.84962],"q":"Q3038877"},{"n":"Sikkal Singaravelan Temple","k":"see","d":"Temple in India","img":"Brihadeeswara.jpg","ll":[10.75665,79.79869],"q":"Q7513767"},{"n":"Loganatha Perumal Temple","k":"see","d":"Angala Parameswari Temple, Royapuram","img":"Thirukannangudi 01 09 2021 withRahul.jpg","ll":[10.75722,79.76333],"q":"Q2808356"},{"n":"Veezhinathar Kovil, Thiruveezhimizhalai","k":"see","d":"Temple in India","img":"Veezhinathar Kovil.jpg","ll":[10.7667,79.8333],"q":"Q7918235"}],"c":[24,27,20,24,28,10,26,30,23,28,32,40,28,33,84,28,33,49,27,32,